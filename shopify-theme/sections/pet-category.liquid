<section class="pet-category section-padding">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-header">
        <h2 class="section-header__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section-header__subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="pet-category__grid">
      {%- for block in section.blocks -%}
        <div class="pet-category__card" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link }}" class="pet-category__card-link">
            <div class="pet-category__card-image">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 600 }}"
                     alt="{{ block.settings.title }}"
                     loading="lazy"
                     width="600" height="600">
              {%- else -%}
                <div class="pet-category__placeholder">
                  <span class="pet-category__placeholder-icon">{{ block.settings.icon }}</span>
                </div>
              {%- endif -%}
              <div class="pet-category__card-overlay"></div>
            </div>
            <div class="pet-category__card-body">
              <h3 class="pet-category__card-title">{{ block.settings.title }}</h3>
              {%- if block.settings.description != blank -%}
                <p class="pet-category__card-desc">{{ block.settings.description }}</p>
              {%- endif -%}
              <span class="pet-category__card-cta">
                {{ block.settings.cta | default: 'ショップを見る' }}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </span>
            </div>
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ペットカテゴリー",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "カテゴリーから探す"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "サブ見出し",
      "default": "いぬ用・ねこ用、それぞれのライフスタイルに合わせた商品をご用意しています"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "カテゴリー",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "画像"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "アイコン（画像がない場合）",
          "default": "🐶"
        },
        {
          "type": "text",
          "id": "title",
          "label": "タイトル",
          "default": "いぬ用品"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "説明",
          "default": "フード・おもちゃ・お散歩グッズ"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "ボタンテキスト",
          "default": "ショップを見る"
        },
        {
          "type": "url",
          "id": "link",
          "label": "リンク先"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ペットカテゴリー",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "icon": "🐶",
            "title": "いぬ用品",
            "description": "フード・おもちゃ・お散歩グッズ",
            "cta": "いぬ用品を見る"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "🐱",
            "title": "ねこ用品",
            "description": "フード・爪とぎ・キャットタワー",
            "cta": "ねこ用品を見る"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "🏠",
            "title": "ハウス・ベッド",
            "description": "快適な住まいを提供する",
            "cta": "ハウスを見る"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "🎀",
            "title": "ファッション",
            "description": "おしゃれなお洋服・アクセサリー",
            "cta": "ファッションを見る"
          }
        }
      ]
    }
  ]
}
{% endschema %}
