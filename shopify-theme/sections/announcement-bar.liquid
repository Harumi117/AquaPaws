{%- if section.settings.show_announcement -%}
<div class="announcement-bar" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="announcement-bar__inner">
    <p class="announcement-bar__message">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" style="color: {{ section.settings.text_color }};">
          {{ section.settings.text }}
        </a>
      {%- else -%}
        {{ section.settings.text }}
      {%- endif -%}
    </p>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "お知らせバー",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "お知らせバーを表示",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "お知らせテキスト",
      "default": "🐾 送料無料キャンペーン実施中！5,500円以上のご購入で送料無料 🐾"
    },
    {
      "type": "url",
      "id": "link",
      "label": "リンク先"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景色",
      "default": "#8B5E3C"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "テキスト色",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "お知らせバー"
    }
  ]
}
{% endschema %}
