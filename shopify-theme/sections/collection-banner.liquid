<div class="collection-banner {% if collection.image %}collection-banner--has-image{% endif %}">
  {%- if collection.image -%}
    <div class="collection-banner__image">
      <img src="{{ collection.image | image_url: width: 1920 }}"
           alt="{{ collection.title | escape }}"
           loading="eager"
           width="1920"
           height="400">
      <div class="collection-banner__overlay"></div>
    </div>
  {%- endif -%}
  <div class="container">
    <div class="collection-banner__content">
      <h1 class="collection-banner__title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="collection-banner__desc">{{ collection.description }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "コレクションバナー",
  "settings": []
}
{% endschema %}
