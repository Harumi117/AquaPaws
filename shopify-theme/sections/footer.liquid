<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="site-footer__grid">

      <div class="site-footer__brand">
        <a href="/" class="site-footer__logo">
          <span class="logo-paw">🐾</span> わたしいぬわたしねこライフ
        </a>
        {%- if section.settings.brand_description != blank -%}
          <p class="site-footer__brand-desc">{{ section.settings.brand_description }}</p>
        {%- endif -%}
        <div class="site-footer__social">
          {%- if section.settings.instagram_url != blank -%}
            <a href="{{ section.settings.instagram_url }}" class="site-footer__social-link" target="_blank" rel="noopener" aria-label="Instagram">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.twitter_url != blank -%}
            <a href="{{ section.settings.twitter_url }}" class="site-footer__social-link" target="_blank" rel="noopener" aria-label="Twitter/X">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.26 5.632zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.line_url != blank -%}
            <a href="{{ section.settings.line_url }}" class="site-footer__social-link" target="_blank" rel="noopener" aria-label="LINE">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.141h1.756c.349 0 .629.283.629.63 0 .344-.28.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div class="site-footer__nav" {{ block.shopify_attributes }}>
            <h3 class="site-footer__nav-title">{{ block.settings.heading }}</h3>
            {%- if linklists[block.settings.menu] != blank -%}
              <ul class="site-footer__nav-list">
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a href="{{ link.url }}" class="site-footer__nav-link">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div class="site-footer__contact">
        <h3 class="site-footer__nav-title">お問い合わせ</h3>
        {%- if section.settings.contact_email != blank -%}
          <p><a href="mailto:{{ section.settings.contact_email }}" class="site-footer__nav-link">{{ section.settings.contact_email }}</a></p>
        {%- endif -%}
        {%- if section.settings.contact_hours != blank -%}
          <p class="site-footer__hours">{{ section.settings.contact_hours }}</p>
        {%- endif -%}
      </div>

    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
      </p>
      <div class="site-footer__legal">
        {%- for link in linklists['footer'].links -%}
          <a href="{{ link.url }}" class="site-footer__legal-link">{{ link.title }}</a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "フッター",
  "settings": [
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "ブランド説明",
      "default": "大切なペットとの毎日を豊かにする商品を厳選してお届けしています。"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "Twitter/X URL"
    },
    {
      "type": "url",
      "id": "line_url",
      "label": "LINE URL"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "メールアドレス",
      "default": "info@watashiinu-neko.jp"
    },
    {
      "type": "text",
      "id": "contact_hours",
      "label": "営業時間",
      "default": "平日 10:00〜17:00"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "リンクリスト",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "見出し",
          "default": "ショップ"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "メニュー"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "フッター"
    }
  ]
}
{% endschema %}
