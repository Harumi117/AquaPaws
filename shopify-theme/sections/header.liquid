<header class="site-header" role="banner">
  <div class="container">
    <div class="site-header__inner">

      <button class="site-header__mobile-menu" aria-label="メニューを開く" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>

      <div class="site-header__logo">
        <a href="/" class="site-header__logo-link">
          {%- if section.settings.logo != blank -%}
            <img src="{{ section.settings.logo | image_url: width: 200 }}"
                 alt="{{ shop.name }}"
                 width="{{ section.settings.logo.width }}"
                 height="{{ section.settings.logo.height }}"
                 loading="eager">
          {%- else -%}
            <span class="site-header__logo-text">
              <span class="logo-paw">🐾</span>
              わたしいぬわたしねこライフ
            </span>
          {%- endif -%}
        </a>
      </div>

      <nav class="site-nav" role="navigation" aria-label="メインナビゲーション">
        <ul class="site-nav__list">
          {%- for link in linklists[section.settings.menu].links -%}
            <li class="site-nav__item {% if link.child_list.size > 0 %}site-nav__item--has-dropdown{% endif %}">
              <a href="{{ link.url }}" class="site-nav__link {% if link.active %}site-nav__link--active{% endif %}">
                {{ link.title }}
                {%- if link.child_list.size > 0 -%}
                  <svg class="icon icon-chevron" width="12" height="8" viewBox="0 0 12 8" aria-hidden="true">
                    <path d="M1 1l5 5 5-5" stroke="currentColor" fill="none" stroke-width="1.5"/>
                  </svg>
                {%- endif -%}
              </a>
              {%- if link.child_list.size > 0 -%}
                <ul class="site-nav__dropdown">
                  {%- for child_link in link.child_list -%}
                    <li><a href="{{ child_link.url }}" class="site-nav__dropdown-link">{{ child_link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      <div class="site-header__actions">
        {%- if shop.customer_accounts_enabled -%}
          <a href="{%- if customer -%}/account{%- else -%}/account/login{%- endif -%}" class="site-header__action-btn" aria-label="アカウント">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
            </svg>
          </a>
        {%- endif -%}

        <a href="/search" class="site-header__action-btn" aria-label="検索">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
        </a>

        <button class="site-header__action-btn site-header__cart-btn" aria-label="カートを開く">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          {%- if cart.item_count > 0 -%}
            <span class="cart-count" aria-label="{{ cart.item_count }}点の商品">{{ cart.item_count }}</span>
          {%- endif -%}
        </button>
      </div>

    </div>
  </div>

  <nav class="mobile-nav" aria-label="モバイルナビゲーション" aria-hidden="true">
    <ul class="mobile-nav__list">
      {%- for link in linklists[section.settings.menu].links -%}
        <li class="mobile-nav__item">
          <a href="{{ link.url }}" class="mobile-nav__link">{{ link.title }}</a>
          {%- if link.child_list.size > 0 -%}
            <ul class="mobile-nav__submenu">
              {%- for child_link in link.child_list -%}
                <li><a href="{{ child_link.url }}" class="mobile-nav__sublink">{{ child_link.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
</header>

{% schema %}
{
  "name": "ヘッダー",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "ロゴ画像"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "ロゴ最大幅",
      "default": 200
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "メニュー",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
