<section class="newsletter section-padding" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">
    <div class="newsletter__inner">
      <div class="newsletter__text">
        <p class="newsletter__eyebrow">🐾 メルマガ登録</p>
        <h2 class="newsletter__heading" style="color: {{ section.settings.heading_color }};">
          {{ section.settings.heading }}
        </h2>
        <p class="newsletter__subheading" style="color: {{ section.settings.text_color }};">
          {{ section.settings.subheading }}
        </p>
      </div>
      <div class="newsletter__form">
        {%- form 'customer', id: 'newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter__form-group">
            <label for="newsletter-email" class="visually-hidden">メールアドレス</label>
            <input type="email"
                   id="newsletter-email"
                   name="contact[email]"
                   class="newsletter__input"
                   placeholder="メールアドレスを入力してください"
                   required
                   autocomplete="email">
            <button type="submit" class="btn btn--primary newsletter__btn">
              {{ section.settings.btn_label | default: '登録する' }}
            </button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="newsletter__success">ご登録ありがとうございます！</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="newsletter__error">{{ form.errors.translated_fields | join: ', ' }}を正しく入力してください。</p>
          {%- endif -%}
        {%- endform -%}
        <p class="newsletter__privacy">登録することでプライバシーポリシーに同意したものとみなします。</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "メルマガ登録",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景色",
      "default": "#FDF6EE"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "見出し色",
      "default": "#2C1810"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "テキスト色",
      "default": "#5C4033"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "ペットライフをもっと楽しく"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "説明文",
      "default": "新商品情報・お得なキャンペーン・ペットケアのヒントをお届けします。\nメルマガ登録で初回10%OFF！"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "ボタンテキスト",
      "default": "無料で登録する"
    }
  ],
  "presets": [
    {
      "name": "メルマガ登録"
    }
  ]
}
{% endschema %}
