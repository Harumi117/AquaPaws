<section class="product-main section-padding">
  <div class="container">
    <div class="product-main__grid">

      <!-- 画像ギャラリー -->
      <div class="product-gallery">
        <div class="product-gallery__main" id="product-gallery-main">
          {%- if product.images.size > 0 -%}
            {%- for image in product.images -%}
              <div class="product-gallery__slide {% if forloop.first %}product-gallery__slide--active{% endif %}"
                   data-index="{{ forloop.index0 }}">
                <img src="{{ image | image_url: width: 900 }}"
                     alt="{{ image.alt | escape | default: product.title }}"
                     loading="{{ forloop.first | ternary: 'eager', 'lazy' }}"
                     width="900"
                     height="{{ 900 | divided_by: image.aspect_ratio | ceil }}"
                     {% if section.settings.enable_zoom %}class="product-gallery__zoomable"{% endif %}>
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="product-gallery__placeholder">
              <span>🐾</span>
            </div>
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="product-gallery__thumbs" role="list">
            {%- for image in product.images -%}
              <button class="product-gallery__thumb {% if forloop.first %}product-gallery__thumb--active{% endif %}"
                      data-index="{{ forloop.index0 }}"
                      aria-label="画像 {{ forloop.index }} を表示">
                <img src="{{ image | image_url: width: 120 }}"
                     alt="{{ image.alt | escape | default: product.title }}"
                     loading="lazy"
                     width="120"
                     height="120">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- 商品情報 -->
      <div class="product-info">

        {%- if section.settings.show_vendor and product.vendor != blank -%}
          <p class="product-info__vendor">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 class="product-info__title">{{ product.title }}</h1>

        <!-- 価格 -->
        <div class="product-info__price" id="product-price">
          {%- if product.compare_at_price > product.price -%}
            <span class="product-info__price--compare">{{ product.compare_at_price | money }}</span>
            <span class="product-info__price--sale">{{ product.price | money }}</span>
            {%- assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
            <span class="badge badge--sale">{{ discount }}% OFF</span>
          {%- else -%}
            <span class="product-info__price--regular">{{ product.price | money }}</span>
          {%- endif -%}
          {%- if product.price_varies -%}
            <span class="product-info__price--from">から</span>
          {%- endif -%}
        </div>

        <p class="product-info__tax-note">税込・送料別</p>

        {%- form 'product', product, id: 'product-form', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="variant-id">

          <!-- バリアント選択 -->
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="product-option">
                <label class="product-option__label">
                  {{ option.name }}
                  <span class="product-option__selected" id="option-selected-{{ forloop.index0 }}">
                    {{ option.selected_value }}
                  </span>
                </label>
                <div class="product-option__values" data-option-index="{{ forloop.index0 }}">
                  {%- for value in option.values -%}
                    <button type="button"
                            class="product-option__value {% if value == option.selected_value %}product-option__value--selected{% endif %}"
                            data-value="{{ value }}">
                      {{ value }}
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <!-- 数量 -->
          <div class="product-quantity">
            <label class="product-quantity__label" for="product-qty">数量</label>
            <div class="product-quantity__input-wrap">
              <button type="button" class="product-quantity__btn product-quantity__btn--minus" aria-label="減らす">−</button>
              <input type="number"
                     id="product-qty"
                     name="quantity"
                     value="1"
                     min="1"
                     class="product-quantity__input"
                     aria-label="数量">
              <button type="button" class="product-quantity__btn product-quantity__btn--plus" aria-label="増やす">＋</button>
            </div>
          </div>

          <!-- カートボタン -->
          <div class="product-info__actions">
            {%- if product.available -%}
              <button type="submit" name="add" class="btn btn--primary btn--large product-add-btn" id="product-add-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
                </svg>
                カートに追加
              </button>
            {%- else -%}
              <button type="button" class="btn btn--primary btn--large" disabled>
                売り切れ
              </button>
            {%- endif -%}
          </div>
        {%- endform -%}

        <!-- 商品ハイライト -->
        <ul class="product-highlights">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            5,500円以上で送料無料
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            ペット専門スタッフが厳選
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            30日間返品保証
          </li>
        </ul>

        <!-- 商品説明 -->
        {%- if product.description != blank -%}
          <div class="product-description">
            <details class="product-description__accordion" open>
              <summary class="product-description__accordion-toggle">商品説明</summary>
              <div class="product-description__content rte">
                {{ product.description }}
              </div>
            </details>
          </div>
        {%- endif -%}

        <!-- タグ -->
        {%- if section.settings.show_tags and product.tags.size > 0 -%}
          <div class="product-tags">
            {%- for tag in product.tags -%}
              <a href="/collections/all/{{ tag | handle }}" class="product-tag">{{ tag }}</a>
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
</section>

<script>
(function () {
  const product = {{ product | json }};

  // Gallery
  const mainEl = document.getElementById('product-gallery-main');
  const thumbBtns = document.querySelectorAll('.product-gallery__thumb');

  thumbBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      const idx = parseInt(btn.dataset.index);
      document.querySelectorAll('.product-gallery__slide').forEach(function (s, i) {
        s.classList.toggle('product-gallery__slide--active', i === idx);
      });
      thumbBtns.forEach(function (b, i) {
        b.classList.toggle('product-gallery__thumb--active', i === idx);
      });
    });
  });

  // Variant selection
  let selectedOptions = {{ product.selected_or_first_available_variant.options | json }};

  document.querySelectorAll('.product-option__values').forEach(function (group) {
    group.addEventListener('click', function (e) {
      const btn = e.target.closest('.product-option__value');
      if (!btn) return;
      const optionIndex = parseInt(group.dataset.optionIndex);
      const value = btn.dataset.value;

      group.querySelectorAll('.product-option__value').forEach(function (b) {
        b.classList.remove('product-option__value--selected');
      });
      btn.classList.add('product-option__value--selected');
      selectedOptions[optionIndex] = value;

      const label = document.getElementById('option-selected-' + optionIndex);
      if (label) label.textContent = value;

      updateVariant();
    });
  });

  function updateVariant() {
    const variant = product.variants.find(function (v) {
      return v.options.every(function (opt, i) { return opt === selectedOptions[i]; });
    });
    if (!variant) return;

    document.getElementById('variant-id').value = variant.id;

    // Update price
    const priceEl = document.getElementById('product-price');
    if (priceEl) {
      if (variant.compare_at_price > variant.price) {
        const discount = Math.round((variant.compare_at_price - variant.price) * 100 / variant.compare_at_price);
        priceEl.innerHTML =
          '<span class="product-info__price--compare">¥' + formatMoney(variant.compare_at_price) + '</span>' +
          '<span class="product-info__price--sale">¥' + formatMoney(variant.price) + '</span>' +
          '<span class="badge badge--sale">' + discount + '% OFF</span>';
      } else {
        priceEl.innerHTML = '<span class="product-info__price--regular">¥' + formatMoney(variant.price) + '</span>';
      }
    }

    // Update add button
    const addBtn = document.getElementById('product-add-btn');
    if (addBtn) {
      addBtn.disabled = !variant.available;
      addBtn.textContent = variant.available ? 'カートに追加' : '売り切れ';
    }
  }

  function formatMoney(cents) {
    return (cents / 100).toLocaleString('ja-JP');
  }

  // Quantity
  const qtyInput = document.getElementById('product-qty');
  document.querySelector('.product-quantity__btn--minus')?.addEventListener('click', function () {
    if (qtyInput.value > 1) qtyInput.value = parseInt(qtyInput.value) - 1;
  });
  document.querySelector('.product-quantity__btn--plus')?.addEventListener('click', function () {
    qtyInput.value = parseInt(qtyInput.value) + 1;
  });

  // Ajax add to cart
  const form = document.getElementById('product-form');
  if (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      const addBtn = document.getElementById('product-add-btn');
      addBtn.disabled = true;
      addBtn.textContent = '追加中...';

      const formData = new FormData(form);
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        body: formData,
      })
        .then(function (res) { return res.json(); })
        .then(function () {
          addBtn.textContent = 'カートに追加しました！';
          // Update cart count
          return fetch('/cart.js');
        })
        .then(function (res) { return res.json(); })
        .then(function (cart) {
          document.querySelectorAll('.cart-count').forEach(function (el) {
            el.textContent = cart.item_count;
            el.style.display = cart.item_count > 0 ? '' : 'none';
          });
          // Open cart drawer
          const drawer = document.getElementById('cart-drawer');
          if (drawer) drawer.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
          setTimeout(function () {
            addBtn.disabled = false;
            addBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>カートに追加';
          }, 2000);
        })
        .catch(function () {
          addBtn.disabled = false;
          addBtn.textContent = 'エラーが発生しました';
        });
    });
  }
})();
</script>

{% schema %}
{
  "name": "商品メイン",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "ブランド名を表示",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "タグを表示",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "画像ズームを有効化",
      "default": true
    }
  ]
}
{% endschema %}
