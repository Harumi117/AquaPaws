<section class="error-404 section-padding">
  <div class="container">
    <div class="error-404__inner">
      <div class="error-404__icon" aria-hidden="true">🐾</div>
      <h1 class="error-404__heading">ページが見つかりません</h1>
      <p class="error-404__message">
        お探しのページは移動・削除されたか、URLが間違っている可能性があります。
      </p>
      <div class="error-404__actions">
        <a href="/" class="btn btn--primary btn--large">トップページへ戻る</a>
        <a href="/collections/all" class="btn btn--outline-dark">商品一覧を見る</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404ページ",
  "settings": []
}
{% endschema %}
